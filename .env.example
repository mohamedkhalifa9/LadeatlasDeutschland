# Copy this file to .env and fill in the values.
#   cp .env.example .env
# .env is git-ignored; this template is committed so the required variables are documented.
# Nothing here is needed until Week 2 — it is here so the shape is visible from day one.

# ─── Azure Data Lake Storage Gen2 — Week 2 ────────────────────────────────
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER_RAW=raw
AZURE_STORAGE_CONTAINER_STAGING=staging
AZURE_STORAGE_CONTAINER_CURATED=curated

# ─── Azure SQL Database (serverless) — Week 7 ─────────────────────────────
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# ─── LLM API for the RAG layer — Week 11 ──────────────────────────────────
LLM_API_KEY=
